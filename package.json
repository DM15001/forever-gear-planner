{
  "name": "forever-gear-planner",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Gear planner for World of Warcraft: Forever. Data and stat weights from WoWSims.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build-data": "node scripts/build-data.mjs",
    "build-sim-values": "node scripts/build-sim-values.mjs",
    "item-report": "node scripts/item-report.mjs",
    "items-to-check": "vite-node scripts/items-to-check.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
